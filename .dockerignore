# Public Docker build context: keep source code, exclude local/private runtime assets.
.git/
.gitignore
.venv/
venv/
**/__pycache__/
*.py[cod]

# Frontend dependencies/build output; frontend is built/deployed separately.
frontend/node_modules/
frontend/dist/
frontend/src_legacy/

# Local databases, logs, and generated state.
*.db
*.sqlite3
data/_alembic_*.db
data/users.json
data/student_graph.json
logs/
*.log

# Secrets are injected at runtime; examples may stay in Git but are not needed in images.
.env
.env.*
youtu-graphrag/.env

# Local/proprietary datasets and documents.
data/raw/*.csv
data/raw/*.xls
data/raw/*.xlsx
docs/
*.pdf
*.docx
*.xls

# Local tools, caches, and local GraphRAG runtime assets.
scripts/
tests/
pytest.ini
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
**/.cache/
.claude/
.trae/
.idea/
.vscode/
youtu-graphrag/

# Model weights should be mounted or downloaded outside the public image build.
/models/
