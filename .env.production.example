# 生产环境配置模板 —— 复制为 .env 填真实值。密钥用强随机，切勿提交到仓库。
APP_ENV=production
LOG_LEVEL=INFO
JSON_LOGS=true
CORS_ORIGINS=https://your-frontend-domain.example

# ── LLM（API Key 必填）─────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_API_KEY=__REQUIRED__
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60
# 主 Provider 失败时降级（可选）
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_MAX_RETRIES=2

# ── 持久化（docker-compose 已为 backend 注入；裸机部署填这里）────
DATABASE_URL=postgresql+asyncpg://career:career@postgres:5432/career
REDIS_URL=redis://redis:6379/0
CACHE_TTL=1800

# ── 检索微服务（可选；空 = 进程内 YOUTU 降级）──────────────────
RETRIEVAL_SERVICE_URL=http://retrieval:8090
RETRIEVAL_TIMEOUT=30

# ── 安全（生产必填，强随机）────────────────────────────────────
JWT_SECRET=__REQUIRED_strong_random_64+chars__
# Fernet base64 密钥：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PII_ENCRYPT_KEY=__REQUIRED_fernet_base64__
AUTH_ENFORCED=true

# ── 限流（每 IP 每分钟；0 = 关）────────────────────────────────
RATE_LIMIT_PER_MIN=120
ENABLE_METRICS=true
