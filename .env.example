# Development environment template
# Copy this file to .env and replace placeholder values locally.

APP_ENV=development
LOG_LEVEL=INFO
JSON_LOGS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider settings; never commit real keys.
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=30
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_MAX_RETRIES=2

# Local services
DATABASE_URL=sqlite:///./data/career_planner.db
REDIS_URL=
CACHE_TTL=300
RETRIEVAL_SERVICE_URL=http://localhost:8001
RETRIEVAL_TIMEOUT=10

# Security; generate strong values for non-local use.
JWT_SECRET=replace-with-a-random-secret
PII_ENCRYPT_KEY=replace-with-a-fernet-key
AUTH_ENFORCED=true
RATE_LIMIT_PER_MIN=60
ENABLE_METRICS=true
